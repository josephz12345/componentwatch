{
  "name": "componentwatch",
  "version": "1.0.0",
  "private": true,
  "description": "A resilient VIPOutlet component price monitor with a five-second scheduler, SQLite history, and an interactive dashboard.",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "live": "node --env-file-if-exists=.env src/server.js --live",
    "test": "node --test",
    "build": "node scripts/build.js",
    "check:live": "node scripts/check-live.js"
  }
}
