# Copy this file to .env. Demo data and live data use different databases.
MODE=demo
HOST=127.0.0.1
PORT=3000
SCAN_INTERVAL_MS=5000
# Optional public project/contact URL for your scraper identity.
USER_AGENT=ComponentWatch/1.0 (personal component price monitor)
# Change log/history retention. Current inventory is retained.
RETENTION_DAYS=90
